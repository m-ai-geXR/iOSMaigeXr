# m{ai}geXR Production Environment Configuration
# Created: 2026-02-08
#
# This file contains production environment variables
# Use for release builds and App Store submissions

# ============================================
# MONETIZATION SETTINGS
# ============================================

# Enable/Disable all ads (true/false)
# MUST be true for production builds
ENABLE_ADS=true

# Force premium mode without subscription (true/false)
# MUST be false for production builds
FORCE_PREMIUM=false

# Show detailed ad debug logs (true/false)
# Should be false for production to reduce console noise
AD_DEBUG_LOGS=false

# ============================================
# AD FREQUENCY SETTINGS (Production)
# ============================================

# Minimum seconds between interstitial ads
# Production: 480 (8 minutes) - balanced for UX
INTERSTITIAL_INTERVAL=480

# Number of scene runs before showing interstitial
# Production: 3 - not too intrusive
SCENES_BEFORE_AD=3

# ============================================
# API KEYS (PRODUCTION)
# ============================================

# AdMob App ID (REPLACE WITH YOUR PRODUCTION APP ID)
# Get from https://admob.google.com → Apps → Your App
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# Unity Ads Game ID (REPLACE WITH YOUR PRODUCTION GAME ID)
# Get from https://unity.com/solutions/unity-ads → Your Project
UNITY_GAME_ID=1234567

# ============================================
# FEATURE FLAGS
# ============================================

# Enable premium subscription features (true/false)
ENABLE_SUBSCRIPTIONS=true

# Enable cloud sync feature (true/false)
ENABLE_CLOUD_SYNC=true

# ============================================
# PRODUCTION CHECKLIST
# ============================================
#
# Before submitting to App Store:
# [ ] ENABLE_ADS=true
# [ ] FORCE_PREMIUM=false
# [ ] AD_DEBUG_LOGS=false
# [ ] Replace test AdMob App ID with production ID
# [ ] Replace test Unity Game ID with production ID
# [ ] Test on physical device (not simulator)
# [ ] Verify ads display correctly
# [ ] Verify premium subscription works
# [ ] Test ad frequency capping
# [ ] Verify GDPR consent flow (EU users)
#
# ============================================
