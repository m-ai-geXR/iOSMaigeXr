	<!-- Home screen and app switcher name. Without this the display name falls
	     back to the target name, which is still XRAiAssistant. -->
	<key>CFBundleDisplayName</key>
	<string>m{ai}geXR</string>

	<!-- The real app ID from the AdMob account on brendonsmith@seacloud9.org
	     (AdMob app "maigeXR iOS"). Not a secret: it ships in every build. Debug
	     builds still load Google's test ad units, which is safe with a real app ID. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-4166973145998533~6620905705</string>

	<!-- Release ad units, read by AdUnits in AdMobProvider.swift. Empty is
	     handled: the provider declines to load rather than crashing, so the app
	     serves no ads until these are filled in. Debug builds use Google's test
	     units instead and ignore these entirely. -->
	<key>GADBannerUnitID</key>
	<string>ca-app-pub-4166973145998533/8678338813</string>
	<key>GADInterstitialUnitID</key>
	<string>ca-app-pub-4166973145998533/4887267611</string>

	<!-- Required for the ATT prompt to appear at all. Without it
	     requestTrackingAuthorization silently returns denied and the IDFA is
	     never available, so ads stay non-personalised forever. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allows m{ai}geXR to show you more relevant ads. Declining keeps ads in the app; they just won't be personalised.</string>

	<!-- Only standard HTTPS and the OS crypto are used, which is exempt from US
	     export rules. Declaring it here skips the export-compliance question on
	     every App Store Connect upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

