# m{ai}geXR Development Environment Configuration
# Created: 2026-02-08
#
# This file contains development environment variables
# Copy this to .env for local development
#
# NOTE: Changes require rebuilding the app to take effect

# ============================================
# MONETIZATION SETTINGS
# ============================================

# Enable/Disable all ads (true/false)
# Set to false during development to disable ads completely
ENABLE_ADS=false

# Force premium mode without subscription (true/false)
# Useful for testing premium features
FORCE_PREMIUM=false

# Show detailed ad debug logs (true/false)
AD_DEBUG_LOGS=true

# ============================================
# AD FREQUENCY SETTINGS (Development)
# ============================================

# Minimum seconds between interstitial ads
# Production: 480 (8 minutes)
# Development: 30 (30 seconds) for faster testing
INTERSTITIAL_INTERVAL=30

# Number of scene runs before showing interstitial
# Production: 3
# Development: 1 for faster testing
SCENES_BEFORE_AD=1

# ============================================
# API KEYS
# ============================================

# AdMob App ID (get from https://admob.google.com)
# Leave as test ID during development
ADMOB_APP_ID=ca-app-pub-3940256099942544~1458002511

# Unity Ads Game ID (get from https://unity.com/solutions/unity-ads)
# Replace with your actual Unity Game ID when ready
UNITY_GAME_ID=YOUR_UNITY_GAME_ID_HERE

# ============================================
# FEATURE FLAGS
# ============================================

# Enable premium subscription features (true/false)
ENABLE_SUBSCRIPTIONS=true

# Enable cloud sync feature (true/false)
ENABLE_CLOUD_SYNC=false

# ============================================
# USAGE INSTRUCTIONS
# ============================================
#
# 1. Copy this file to .env in the same directory
# 2. Modify values as needed
# 3. Add .env to .gitignore to keep secrets private
# 4. Rebuild the app for changes to take effect
#
# XCODE SETUP:
# 1. Open your Xcode scheme (Product → Scheme → Edit Scheme)
# 2. Select "Run" on the left
# 3. Go to "Arguments" tab
# 4. Under "Environment Variables", add variables from this file
#
# Example:
#   Name: ENABLE_ADS
#   Value: false
#
# ============================================
